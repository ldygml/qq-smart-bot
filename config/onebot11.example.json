{
  "network": {
    "httpServers": [
      {
        "name": "ai-api",
        "enable": true,
        "port": 3000,
        "host": "127.0.0.1",
        "enableCors": false,
        "enableWebsocket": false,
        "messagePostFormat": "array",
        "token": "replace-with-the-same-token-as-.env",
