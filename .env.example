# FastAPI webhook server
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8090

# NapCat's OneBot HTTP API
ONEBOT_API_BASE=http://127.0.0.1:3000
# Use the same token for both NapCat HTTP Server and HTTP Client
ONEBOT_TOKEN=replace-with-a-long-random-token
ADMIN_REQUIRE_AUTH=true
# Optional separate admin token; when empty, ONEBOT_TOKEN is used.
ADMIN_API_TOKEN=

# Alibaba Cloud Model Studio (DashScope), OpenAI-compatible API.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
CASUAL_MODEL=qwen3.8-flash
CODE_MODEL=qwen3.8-flash
CODE_FALLBACK_MODEL=qwen-plus
# You can also set DASHSCOPE_API_KEY in the environment.
LLM_API_KEY=
LLM_TEMPERATURE=0.8
LLM_TIMEOUT_SECONDS=90
LLM_TRUST_ENV=false
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
# Optional JSON route map generated by the login control plane.
MODEL_ROUTES_JSON=
WEB_SEARCH_ENABLED=true
WEB_READER_ENABLED=true
WEB_READER_TIMEOUT_SECONDS=30
VECTOR_MEMORY_ENABLED=true
EMBEDDING_MODEL=qwen3.7-text-embedding
KNOWLEDGE_TOP_K=5
VISION_ENABLED=true
VISION_MODEL=qwen3-vl-plus
OCR_ENABLED=true
MAX_IMAGE_BYTES=0
MAX_IMAGES_PER_MESSAGE=3
IMAGE_TIMEOUT_SECONDS=30
MAX_FILES_PER_MESSAGE=3
DOCUMENT_TIMEOUT_SECONDS=120
AUDIO_ENABLED=true
AUDIO_MODEL=qwen3.8-omni-flash
AUDIO_TIMEOUT_SECONDS=120
TTS_ENABLED=true
TTS_MODEL=qwen-audio-3.1-tts-flash
TTS_VOICE=longanhuan_v3.1
TTS_VOICE_CALM=
TTS_VOICE_LIVELY=
TTS_VOICE_SAD=
TTS_RATE=1.0
MAX_TTS_CHARS=800
MEDIA_SEND_ENABLED=true
GENERATED_MEDIA_DIR=data/generated
AUTO_STICKER_ENABLED=true
STICKER_MODEL=qwen3.8-flash
STICKER_MIN_CONFIDENCE=0.7
AUTO_STICKER_COOLDOWN_SECONDS=180
ADMIN_WEB_ENABLED=true
SHARED_MEMORY_ENABLED=true
MEMORY_MODEL=qwen3.8-flash
MEMORY_CONTEXT_LIMIT=14
MEMORY_PRIVACY_PROTECTION=true
PROFILE_LEARNING_ENABLED=true
PROFILE_UPDATE_AFTER_MESSAGES=5
RELATIONSHIP_INACTIVE_DAYS=14
REFLECTION_ENABLED=true
REFLECTION_MODEL=qwen-plus
REFLECTION_INTERVAL_SECONDS=1200
REFLECTION_MIN_NEW_MEMORIES=1

# Bot behavior
BOT_NAME=给她爱
PERSONA_PROMPT_PATH=prompts/gexiai.md
BOT_PERSONA=一个懂球、爱看比赛的普通年轻人，有自己的审美、判断和脾气。平时说话自然松弛，不端着；遇到离谱、装懂或明显甩锅时才会变犀利。不靠刻薄、反问和拆台证明个性，普通问候就正常回应。

# Leave empty to allow all private chats. Comma-separated QQ IDs also work.
PRIVATE_ALLOWLIST=

# Groups are off by default to reduce spam and account risk.
ENABLE_GROUP=false
GROUP_ALLOWLIST=
GROUP_REQUIRE_MENTION=true
GROUP_TRIGGER_PREFIXES=/ai,/问
GROUP_SMART_PARTICIPATION=true
GROUP_PARTICIPATION_MODEL=qwen3.8-flash
GROUP_MIN_REPLY_CONFIDENCE=0.65
GROUP_REPLY_COOLDOWN_SECONDS=90
GROUP_BEHAVIOR_LEARNING=true
GROUP_POKE_POLICY=allow
GROUP_ACTIVE_HOURS=
GROUP_BLOCKED_KEYWORDS=
GROUP_QUOTE_MODE=smart
GROUP_WELCOME_MESSAGE=
GROUP_ANNOUNCEMENT_DIGEST_HOURS=24
NATURAL_PACING_ENABLED=false
NATURAL_MESSAGE_DEBOUNCE_MS=0
NATURAL_REPLY_DELAY_MIN_MS=200
NATURAL_REPLY_DELAY_MAX_MS=900
NATURAL_SPLIT_REPLIES=true
QUOTE_REPLIES=true
GROUP_QUOTE_COUNTS_AS_MENTION=true

# Context and abuse protection
HISTORY_MESSAGES=40
MAX_HISTORY_ROWS_PER_CHAT=160
RATE_LIMIT_PER_MINUTE=8
MAX_CONCURRENT_REQUESTS=4
QUALITY_REVIEW_ENABLED=true
QUALITY_REVIEW_INTERVAL_SECONDS=1800
QUALITY_REVIEW_BATCH_SIZE=8
ADAPTIVE_REPLY_ENABLED=true
ADAPTIVE_REPLY_SAMPLE_RATE=0.15
CONTACT_POLICY_ENABLED=true
TOPIC_STATE_ENABLED=true
TOPIC_UPDATE_AFTER_MESSAGES=3
TOPIC_STALE_AFTER_HOURS=12
PRESENCE_ENABLED=true
DATABASE_PATH=data/bot.db
TIMEZONE=Asia/Shanghai
REMINDER_POLL_SECONDS=15

